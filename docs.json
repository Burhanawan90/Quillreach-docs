{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Quillreach Help",
  "description": "How to use Quillreach: connect LinkedIn, import leads, run campaigns and manage your team.",
  "colors": {
    "primary": "#65A30D",
    "light": "#BCF94B",
    "dark": "#4D7C0F"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://quillreach.com"
  },
  "navigation": {
    "groups": [
      { "group": "Get started", "pages": ["index", "get-started/create-your-workspace", "get-started/connect-linkedin", "get-started/first-campaign"] },
      { "group": "Campaigns", "pages": ["campaigns/import-leads", "campaigns/build-your-sequence", "campaigns/run-and-manage", "campaigns/templates"] },
      { "group": "AI", "pages": ["ai/account-safety", "ai/ai-prompts"] },
      { "group": "Leads and inbox", "pages": ["leads-and-inbox/leads", "leads-and-inbox/inbox", "leads-and-inbox/analytics"] },
      { "group": "Your account", "pages": ["account/billing", "account/team-members", "account/settings", "account/support"] }
    ]
  },
  "navbar": {
    "links": [
      { "label": "Support", "href": "mailto:support@quillreach.com" }
    ],
    "primary": {
      "type": "button",
      "label": "Open Quillreach",
      "href": "https://app.quillreach.com"
    }
  },
  "contextual": {
    "options": ["copy"]
  },
  "footer": {
    "socials": {
      "website": "https://quillreach.com"
    }
  }
